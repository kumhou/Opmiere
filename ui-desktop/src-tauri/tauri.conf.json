{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Opmiere",
  "version": "0.6.8",
  "identifier": "com.opmiere.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Opmiere",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Video",
    "shortDescription": "Opmiere desktop shell — NLE product UI over Python Editor",
    "longDescription": "Human-facing product shell for Opmiere. Requires the Opmiere Python core API (opmiere web) on localhost.",
    "copyright": "Copyright (c) Opmiere contributors",
    "publisher": "kumhou",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
